{
  "name": "gcav-build",
  "version": "1.0.0",
  "description": "Browser game with Supabase Realtime multiplayer and authenticated player wallets",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/game.js --bundle --minify --outfile=dist/game.js",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js",
    "start": "npm run build && node --env-file-if-exists=.env server/index.js"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
